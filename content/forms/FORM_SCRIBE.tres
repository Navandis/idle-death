[gd_resource type="Resource" script_class="FormDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://src/content/definitions/form_definition.gd" id="1_FormDefinition"]
[ext_resource type="Script" path="res://src/content/subresources/modifier_definition.gd" id="2_ModifierDefinition"]
[ext_resource type="Script" path="res://src/content/subresources/rate_definition.gd" id="3_RateDefinition"]
[ext_resource type="Script" path="res://src/content/subresources/trait_definition.gd" id="4_TraitDefinition"]
[ext_resource type="Script" path="res://src/content/subresources/item_amount_definition.gd" id="5_ItemAmountDefinition"]

[sub_resource type="Resource" id="ModifierDefinition_1"]
script = ExtResource("2_ModifierDefinition")
metric = "DISCOVERY_RATE"
operation = "MULTIPLY"
scope = "REAPING_TOTAL"
condition = "ALWAYS"
value = 2.0
condition_values = []

[sub_resource type="Resource" id="ModifierDefinition_2"]
script = ExtResource("2_ModifierDefinition")
metric = "FORECAST_UNCERTAINTY"
operation = "MULTIPLY"
scope = "FORECAST_ONLY"
condition = "ALWAYS"
value = 0.5
condition_values = []

[sub_resource type="Resource" id="RateDefinition_3"]
script = ExtResource("3_RateDefinition")
amount_per_period = 1.0
period_msec = 1000

[sub_resource type="Resource" id="RateDefinition_4"]
script = ExtResource("3_RateDefinition")
amount_per_period = 1.0
period_msec = 60000

[sub_resource type="Resource" id="TraitDefinition_5"]
script = ExtResource("4_TraitDefinition")
id = "TRAIT_UNCLOSED_LEDGER"
display_name = "Unclosed Ledger"
description = "Prototype trait scaffold."
localization_key = ""
modifiers = [SubResource("ModifierDefinition_1"), SubResource("ModifierDefinition_2")]

[sub_resource type="Resource" id="ItemAmountDefinition_6"]
script = ExtResource("5_ItemAmountDefinition")
item_id = "SOUL_FORM_SCRIBE"
quantity = 1

[sub_resource type="Resource" id="ItemAmountDefinition_7"]
script = ExtResource("5_ItemAmountDefinition")
item_id = "RES_ESSENCE"
quantity = 50

[resource]
script = ExtResource("1_FormDefinition")
id = "FORM_SCRIBE"
display_name = "Scribe"
description = "Prototype scaffold definition."
localization_key = ""
enabled = true
notes = ""
base_returned_souls_rate = SubResource("RateDefinition_3")
active_mastery_rate = SubResource("RateDefinition_4")
cycle_duration_msec = 60000
traits = [SubResource("TraitDefinition_5")]
slot_affinities = ["SPECIALIST", "LOGISTICS_OR_EXTRACTION"]
awakening_costs = [SubResource("ItemAmountDefinition_6"), SubResource("ItemAmountDefinition_7")]
