{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Navandis/idle-death/tools/codex/workflow-state.schema.json",
  "title": "Workflow-state public document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "generated_at_utc", "result", "repository", "tools", "workspace", "github", "queries"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": { "const": "verify_workflow_state" },
    "generated_at_utc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$" },
    "result": { "enum": ["pass", "partial", "fail"] },
    "repository": { "$ref": "#/$defs/repository" },
    "tools": { "$ref": "#/$defs/tools" },
    "workspace": { "$ref": "#/$defs/workspace" },
    "github": { "$ref": "#/$defs/github" },
    "queries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/query" } }
  },
  "allOf": [
    { "if": { "properties": { "result": { "const": "pass" } } }, "then": { "properties": { "queries": { "not": { "contains": { "properties": { "ok": { "const": false } }, "required": ["ok"] } } } } } },
    { "if": { "properties": { "result": { "const": "partial" } } }, "then": { "properties": { "queries": { "contains": { "properties": { "scope": { "const": "github" }, "ok": { "const": false } }, "required": ["scope", "ok"] }, "allOf": [{ "not": { "contains": { "properties": { "scope": { "not": { "const": "github" } }, "ok": { "const": false } }, "required": ["scope", "ok"] } } }] } } } },
    { "if": { "properties": { "result": { "const": "fail" } } }, "then": { "properties": { "queries": { "contains": { "properties": { "scope": { "enum": ["local", "invariant", "schema"] }, "ok": { "const": false } }, "required": ["scope", "ok"] } } } } }
  ],
  "$defs": {
    "nullable_string": { "type": ["string", "null"] },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullable_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "nullable_uri": { "type": ["string", "null"], "format": "uri" },
    "unique_strings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "full_name", "remote_name", "origin_fetch_urls", "origin_push_urls", "branch", "head", "origin_main", "remote_main", "upstream", "remote_feature_sha"],
      "properties": {
        "root": { "$ref": "#/$defs/nullable_string" }, "full_name": { "const": "Navandis/idle-death" }, "remote_name": { "const": "origin" },
        "origin_fetch_urls": { "allOf": [{ "$ref": "#/$defs/unique_strings" }], "items": { "const": "https://github.com/Navandis/idle-death" } },
        "origin_push_urls": { "allOf": [{ "$ref": "#/$defs/unique_strings" }], "items": { "const": "https://github.com/Navandis/idle-death" } },
        "branch": { "$ref": "#/$defs/nullable_string" }, "head": { "$ref": "#/$defs/nullable_sha" }, "origin_main": { "$ref": "#/$defs/nullable_sha" }, "remote_main": { "$ref": "#/$defs/nullable_sha" }, "upstream": { "$ref": "#/$defs/nullable_string" }, "remote_feature_sha": { "$ref": "#/$defs/nullable_sha" }
      },
      "allOf": [{ "if": { "properties": { "branch": { "const": "main" } }, "required": ["branch"] }, "then": { "properties": { "remote_feature_sha": { "type": "null" } } } }]
    },
    "tools": { "type": "object", "additionalProperties": false, "required": ["git_path", "git_version", "gh_path", "gh_version"], "properties": { "git_path": { "$ref": "#/$defs/nullable_string" }, "git_version": { "$ref": "#/$defs/nullable_string" }, "gh_path": { "$ref": "#/$defs/nullable_string" }, "gh_version": { "$ref": "#/$defs/nullable_string" } } },
    "workspace": { "type": "object", "additionalProperties": false, "required": ["status_entries", "staged_paths", "publish_request_present", "index_lock_path", "index_lock_present"], "properties": { "status_entries": { "$ref": "#/$defs/unique_strings" }, "staged_paths": { "$ref": "#/$defs/unique_strings" }, "publish_request_present": { "type": "boolean" }, "index_lock_path": { "$ref": "#/$defs/nullable_string" }, "index_lock_present": { "type": "boolean" } } },
    "pull_request": { "type": "object", "additionalProperties": false, "required": ["number", "url", "state", "draft", "mergeable", "base_ref", "head_ref", "head_sha", "author", "labels", "auto_merge"], "properties": { "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string", "format": "uri" }, "state": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "draft": { "type": "boolean" }, "mergeable": { "type": ["boolean", "null"] }, "base_ref": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "head_ref": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "head_sha": { "$ref": "#/$defs/sha" }, "author": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "labels": { "$ref": "#/$defs/unique_strings" }, "auto_merge": { "type": ["boolean", "null"] } } },
    "check_run": { "type": "object", "additionalProperties": false, "required": ["id", "name", "status", "conclusion", "app_id", "app_name", "app_slug", "details_url"], "properties": { "id": { "type": ["integer", "null"] }, "name": { "$ref": "#/$defs/nullable_string" }, "status": { "$ref": "#/$defs/nullable_string" }, "conclusion": { "$ref": "#/$defs/nullable_string" }, "app_id": { "type": ["integer", "null"] }, "app_name": { "$ref": "#/$defs/nullable_string" }, "app_slug": { "$ref": "#/$defs/nullable_string" }, "details_url": { "$ref": "#/$defs/nullable_uri" } } },
    "workflow_run": { "type": "object", "additionalProperties": false, "required": ["id", "name", "number", "attempt", "event", "status", "conclusion", "head_branch", "head_sha", "url"], "properties": { "id": { "type": ["integer", "null"] }, "name": { "$ref": "#/$defs/nullable_string" }, "number": { "type": ["integer", "null"] }, "attempt": { "type": ["integer", "null"] }, "event": { "$ref": "#/$defs/nullable_string" }, "status": { "$ref": "#/$defs/nullable_string" }, "conclusion": { "$ref": "#/$defs/nullable_string" }, "head_branch": { "$ref": "#/$defs/nullable_string" }, "head_sha": { "$ref": "#/$defs/nullable_sha" }, "url": { "$ref": "#/$defs/nullable_uri" } } },
    "review_item": { "type": "object", "additionalProperties": false, "required": ["id", "is_resolved", "is_outdated", "path", "line"], "properties": { "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "is_resolved": { "type": "boolean" }, "is_outdated": { "type": "boolean" }, "path": { "$ref": "#/$defs/nullable_string" }, "line": { "type": ["integer", "null"], "minimum": 1 } } },
    "review_threads": { "type": "object", "additionalProperties": false, "required": ["total_count", "unresolved_count", "items"], "properties": { "total_count": { "type": "integer", "minimum": 0 }, "unresolved_count": { "type": "integer", "minimum": 0 }, "items": { "type": "array", "items": { "$ref": "#/$defs/review_item" } } } },
    "github": { "type": "object", "additionalProperties": false, "required": ["login", "matching_pr_count", "pull_request", "check_runs", "workflow_runs", "review_threads"], "properties": { "login": { "$ref": "#/$defs/nullable_string" }, "matching_pr_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "pull_request": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pull_request" }] }, "check_runs": { "type": "array", "items": { "$ref": "#/$defs/check_run" } }, "workflow_runs": { "type": "array", "items": { "$ref": "#/$defs/workflow_run" } }, "review_threads": { "$ref": "#/$defs/review_threads" } }, "allOf": [{ "if": { "properties": { "pull_request": { "type": "null" } }, "required": ["pull_request"] }, "then": { "properties": { "matching_pr_count": { "const": 0 } } }, "else": { "properties": { "matching_pr_count": { "const": 1 } } } }] },
    "query": { "type": "object", "additionalProperties": false, "required": ["scope", "name", "ok", "exit_code", "error"], "properties": { "scope": { "enum": ["local", "github", "invariant", "schema"] }, "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "ok": { "type": "boolean" }, "exit_code": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 }, "error": { "type": ["string", "null"], "maxLength": 512 } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] }, "then": { "properties": { "error": { "type": "null" } } }, "else": { "properties": { "error": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" } } } }] }
  }
}
